{
  "expo": {
    "name": "My Vibe",
    "slug": "my-vibe-mobile",
    "version": "1.0.0",
    "scheme": "myvibe",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mikewilley.myvibemobile",
      "infoPlist": {
        "NSCalendarsFullAccessUsageDescription": "My Vibe checks saved events to prevent duplicates and adds only the plans you choose.",
        "NSCalendarsUsageDescription": "My Vibe adds the plans you choose to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.mikewilley.myvibemobile",
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#F7F4EF",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "./plugins/withIosMinDeployment",
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "My Vibe checks saved events to prevent duplicates and adds only the plans you choose."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EF"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f97907f3-96ef-4ac5-a434-6d7d66a14beb"
      }
    },
    "owner": "mikewilley"
  }
}
