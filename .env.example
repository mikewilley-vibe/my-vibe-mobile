EXPO_PUBLIC_API_BASE_URL=https://www.mikewilley.app

# ShowSignal production API for the Shows tab (Ticketmaster events).
# UVA still uses EXPO_PUBLIC_API_BASE_URL above.
EXPO_PUBLIC_SHOWSIGNAL_API_BASE_URL=https://concert-finder-eta.vercel.app

# Optional override for the in-app Google Calendar Month (default) and Agenda views on the My calendar tab.
# Must be an https://calendar.google.com/.../calendar/embed URL (no OAuth secrets).
# Launch opens Calendar. Family Month/Agenda embed stays at the top; the native month grid is reused below it.
# Viewing uses this public embed; adding a plan uses the matching Google calendar already synced on the phone.
# If unset, My Vibe uses this public family calendar:
# https://calendar.google.com/calendar/embed?src=mikewilley%40gmail.com&ctz=America%2FNew_York
# EXPO_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=mikewilley%40gmail.com&ctz=America%2FNew_York

# SweatShift — leave unset until SweatShift exposes a public API (see INTEGRATIONS.md).
# Do not invent a production host. When it exists:
# EXPO_PUBLIC_SWEATSHIFT_API_BASE_URL=
# Optional https fallback if the native app is not installed:
# EXPO_PUBLIC_SWEATSHIFT_URL=
# Optional custom scheme override (default from the public SweatShift app.json: workouttimermobile)
# EXPO_PUBLIC_SWEATSHIFT_SCHEME=

# HapsHere — no production URL is stored in this repo. Set one to enable Open from My Apps:
# EXPO_PUBLIC_HAPSHERE_URL=
# EXPO_PUBLIC_HAPSHERE_SCHEME=
